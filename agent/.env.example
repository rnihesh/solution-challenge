# Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Murf AI (Text-to-Speech)
MURF_API_KEY=your_murf_api_key

# Azure Whisper (Speech-to-Text) - preferred
AZURE_WHISPER_ENDPOINT=https://your-resource.openai.azure.com/openai/deployments/whisper/audio/translations?api-version=2024-06-01
AZURE_WHISPER_API_KEY=your_azure_whisper_api_key

# OpenAI Whisper (optional fallback - browser fallback also available)
OPENAI_API_KEY=

# Google Maps API Key (used for Maps and Weather API)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Service URLs
MAIN_SERVER_URL=http://localhost:3001
ML_SERVICE_URL=http://localhost:8000

# Firebase (from server/serviceAccountKey.json)
FIREBASE_PROJECT_ID=civiclemma
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@civiclemma.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
